# StockSense Environment Configuration
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stocksense?schema=public"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="stocksense-dev-secret-key-change-in-production-min-32-chars"

# App Settings
NEXT_PUBLIC_APP_NAME="StockSense"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
